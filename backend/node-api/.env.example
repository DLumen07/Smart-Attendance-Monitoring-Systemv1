# Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_attendance

# JWT secret used to sign tokens
JWT_SECRET=replace-this-with-a-secure-secret

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# SMTP (optional) for password reset emails
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=noreply@smart-attendance.local
MAIL_FROM_NAME="Smart Attendance"
MAIL_REPLY_TO=

# Attendance
LATE_CUTOFF_MINUTES=5
ATTENDANCE_EMAIL_ENABLED=false

# MySQL migration (optional)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_attendance
MIGRATE_TRUNCATE=false
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_attendance
JWT_SECRET=replace-this-in-production

